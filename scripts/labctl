#!/usr/bin/env bash
# labctl: create and destroy "namespace nodes" on one Linux host.
#
# Each node is:
#   - a network namespace   lab-node-NNNN
#   - a veth pair           vlabNNNN (host, on the bridge) <-> eth0 (in the namespace)
#   - an IP address         10.77.X.Y/16 on bridge br-lab (no default route)
#   - a dedicated Unix user lab-node-NNNN, UID/GID = 47000 + N
#   - a private directory   /var/lib/spiffe-lab/nodes/lab-node-NNNN (0700)
#
# The per-node Unix user exists so SPIRE's `unix` workload attestor can tell
# nodes apart (selectors like unix:user:lab-node-0003). Network namespaces do
# not separate users, filesystems or the kernel: see docs/trust-levels.md.
#
# Usage: labctl <command> [args]   (run `labctl help`)

set -euo pipefail
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"

usage() {
    cat <<EOF
Usage: $(basename "$0") <command> [args]

  up N            Ensure the bridge and firewall exist, and nodes 1..N exist (idempotent).
  add [COUNT]     Add COUNT (default 1) nodes after the highest existing ID.
  del ID...       Delete the given nodes (kills their processes).
  down            Delete every node, the firewall rules and the bridge.
  status          Show nodes (works without root; some columns need root).
  exec ID -- CMD  Run CMD inside node ID's namespace as its Unix user.
  shell ID        Interactive shell inside node ID's namespace as its user.

Environment overrides: LAB_BRIDGE LAB_NET LAB_NODE_PREFIX LAB_VETH_PREFIX
                       LAB_UID_BASE LAB_STATE_DIR LAB_NFT_TABLE
EOF
}

# --- Bridge -----------------------------------------------------------------------
bridge_up() {
    if ! link_exists "${LAB_BRIDGE}"; then
        log "creating bridge ${LAB_BRIDGE} ($(bridge_ip)/16)"
        ip link add "${LAB_BRIDGE}" type bridge
    fi
    if ! ip -4 addr show dev "${LAB_BRIDGE}" | grep -q "inet $(bridge_ip)/16"; then
        ip addr add "$(bridge_ip)/16" dev "${LAB_BRIDGE}"
    fi
    ip link set "${LAB_BRIDGE}" up
}

bridge_down() {
    if link_exists "${LAB_BRIDGE}"; then
        log "deleting bridge ${LAB_BRIDGE}"
        ip link del "${LAB_BRIDGE}"
    fi
}

# --- Firewall ---------------------------------------------------------------------
# Two separate concerns:
#
# 1. Keep the lab off the LAN. This host has net.ipv4.ip_forward=1 (Docker), so
#    without a rule a LAN machine with a static route could reach 10.77.0.0/16
#    through this box, and the reverse. Our own nftables table drops any
#    forwarded packet that enters or leaves the bridge via another interface.
#    In nftables a drop in any table is final, so this holds regardless of
#    what Docker or libvirt add.
#
# 2. Let nodes talk to each other. With br_netfilter loaded and
#    bridge-nf-call-iptables=1, bridged traffic between two veths goes through
#    the iptables FORWARD chain, where Docker sets policy DROP. An accept in
#    our own nft table cannot override a drop in Docker's chain, so we insert
#    an ACCEPT for bridge->same-bridge into DOCKER-USER (Docker's documented
#    hook for user rules) or, without Docker, into FORWARD when its policy is
#    DROP. Rules carry a comment so `down` removes exactly what we added.
fw_up() {
    log "installing nftables table inet ${LAB_NFT_TABLE} (lab <-> other interfaces: drop)"
    nft -f - <<EOF
table inet ${LAB_NFT_TABLE}
flush table inet ${LAB_NFT_TABLE}
table inet ${LAB_NFT_TABLE} {
    chain forward {
        type filter hook forward priority filter - 10; policy accept;
        iifname "${LAB_BRIDGE}" oifname != "${LAB_BRIDGE}" counter drop comment "lab must not reach other networks"
        oifname "${LAB_BRIDGE}" iifname != "${LAB_BRIDGE}" counter drop comment "other networks must not reach lab"
    }
}
EOF

    local chain=""
    if iptables -n -L DOCKER-USER >/dev/null 2>&1; then
        chain=DOCKER-USER
    elif iptables -S FORWARD 2>/dev/null | grep -qx -- '-P FORWARD DROP'; then
        chain=FORWARD
    fi
    if [[ -n ${chain} ]]; then
        local rule=(-i "${LAB_BRIDGE}" -o "${LAB_BRIDGE}" -m comment --comment "${LAB_IPT_COMMENT}" -j ACCEPT)
        if ! iptables -C "${chain}" "${rule[@]}" 2>/dev/null; then
            log "allowing ${LAB_BRIDGE}<->${LAB_BRIDGE} in iptables ${chain} (needed because of br_netfilter + DROP policy)"
            iptables -I "${chain}" 1 "${rule[@]}"
        fi
    fi
}

fw_down() {
    if nft list table inet "${LAB_NFT_TABLE}" >/dev/null 2>&1; then
        log "removing nftables table inet ${LAB_NFT_TABLE}"
        nft delete table inet "${LAB_NFT_TABLE}"
    fi
    local chain rule=(-i "${LAB_BRIDGE}" -o "${LAB_BRIDGE}" -m comment --comment "${LAB_IPT_COMMENT}" -j ACCEPT)
    for chain in DOCKER-USER FORWARD; do
        while iptables -C "${chain}" "${rule[@]}" 2>/dev/null; do
            log "removing iptables ${chain} accept rule"
            iptables -D "${chain}" "${rule[@]}"
        done
    done
}

# --- Users --------------------------------------------------------------------------
user_up() {
    local id=$1 name uid home
    name=$(node_name "${id}"); uid=$(node_uid "${id}"); home=$(node_home "${id}")

    if getent passwd "${name}" >/dev/null; then
        is_lab_user "${name}" || die "user ${name} exists but was not created by this lab; refusing to touch it"
    else
        # Refuse to reuse a UID/GID that belongs to someone else.
        if getent passwd "${uid}" >/dev/null; then die "UID ${uid} already in use"; fi
        if getent group "${name}" >/dev/null; then die "group ${name} already exists"; fi
        if getent group "${uid}" >/dev/null; then die "GID ${uid} already in use"; fi
        groupadd --gid "${uid}" "${name}"
        # No login shell, no password: nodes are entered only via `labctl exec`.
        useradd --uid "${uid}" --gid "${uid}" --no-create-home \
            --home-dir "${home}" --shell /usr/sbin/nologin \
            --comment "${LAB_MARKER}" "${name}"
        log "created user ${name} (uid ${uid})"
    fi
    install -d -m 0755 "${LAB_STATE_DIR}" "${LAB_STATE_DIR}/nodes"
    # 0700: other node users cannot read this node's files (root still can).
    install -d -m 0700 -o "${uid}" -g "${uid}" "${home}"
}

user_down() {
    local id=$1 name home
    name=$(node_name "${id}"); home=$(node_home "${id}")
    if is_lab_user "${name}"; then
        pkill -KILL -u "${name}" 2>/dev/null || true
        # Give the kernel a moment to reap killed processes before userdel.
        for _ in 1 2 3 4 5; do pgrep -u "${name}" >/dev/null || break; sleep 0.2; done
        userdel "${name}"
        log "deleted user ${name}"
    elif getent passwd "${name}" >/dev/null; then
        warn "user ${name} exists but is not a lab user; leaving it alone"
    fi
    if getent group "${name}" >/dev/null && [[ $(getent group "${name}" | cut -d: -f3) == "$(node_uid "${id}")" ]]; then
        groupdel "${name}" 2>/dev/null || true
    fi
    # Path is built only from validated config + a 4-digit ID; double-check anyway.
    if [[ ${home} == "${LAB_STATE_DIR}/nodes/${LAB_NODE_PREFIX}-"[0-9][0-9][0-9][0-9] && -d ${home} ]]; then
        rm -rf -- "${home}"
    fi
}

# --- Nodes ---------------------------------------------------------------------------
node_up() {
    local id=$1 name veth ip
    name=$(node_name "${id}"); veth=$(veth_host "${id}"); ip=$(node_ip "${id}")

    user_up "${id}"

    if ! netns_exists "${name}"; then
        ip netns add "${name}"
    fi
    ip -n "${name}" link set lo up

    if ! link_exists "${veth}"; then
        # A stale eth0 inside the namespace would block re-creating the pair.
        ip -n "${name}" link del eth0 2>/dev/null || true
        ip link add "${veth}" type veth peer name eth0 netns "${name}"
    fi
    ip link set "${veth}" master "${LAB_BRIDGE}" up

    if ! ip -n "${name}" -4 addr show dev eth0 | grep -q "inet ${ip}/16"; then
        ip -n "${name}" addr flush dev eth0
        ip -n "${name}" addr add "${ip}/16" dev eth0
    fi
    ip -n "${name}" link set eth0 up
    # Deliberately NO default route: a node can reach only the lab /16
    # (other nodes and the host at $(bridge_ip)), not the LAN or internet.
    log "node ${name} up: ${ip} via ${veth}"
}

node_down() {
    local id=$1 name veth
    name=$(node_name "${id}"); veth=$(veth_host "${id}")
    if netns_exists "${name}"; then
        # Processes inside a namespace keep it alive even after `ip netns del`,
        # so kill them first (this covers root processes started via exec).
        local pids
        pids=$(ip netns pids "${name}" 2>/dev/null || true)
        if [[ -n ${pids} ]]; then
            # shellcheck disable=SC2086 # word-splitting the PID list is intended
            kill -KILL ${pids} 2>/dev/null || true
        fi
        ip netns del "${name}"
    fi
    # Deleting the namespace destroys eth0 and therefore its veth peer;
    # this is just a fallback.
    if link_exists "${veth}"; then ip link del "${veth}"; fi
    user_down "${id}"
    log "node ${name} removed"
}

# --- Commands --------------------------------------------------------------------------
cmd_up() {
    [[ $# -eq 1 ]] || die "usage: up N"
    validate_id "$1"
    require_root up
    bridge_up
    fw_up
    local i
    for (( i = 1; i <= 10#$1; i++ )); do node_up "${i}"; done
}

cmd_add() {
    local count=${1:-1} last=0 i
    [[ ${count} =~ ^[0-9]+$ && ${count} -ge 1 ]] || die "usage: add [COUNT>=1]"
    require_root add
    last=$(existing_ids | tail -n1); last=$((10#${last:-0}))
    (( last + count <= LAB_MAX_NODES )) || die "would exceed ${LAB_MAX_NODES} nodes"
    bridge_up
    fw_up
    for (( i = last + 1; i <= last + count; i++ )); do node_up "${i}"; done
}

cmd_del() {
    [[ $# -ge 1 ]] || die "usage: del ID..."
    local id
    for id in "$@"; do validate_id "${id}"; done
    require_root del
    for id in "$@"; do node_down "${id}"; done
}

cmd_down() {
    require_root down
    local id
    for id in $(existing_ids); do node_down "${id}"; done
    fw_down
    bridge_down
    # Leave LAB_STATE_DIR itself if anything unexpected is still in it.
    rmdir "${LAB_STATE_DIR}/nodes" "${LAB_STATE_DIR}" 2>/dev/null || true
}

cmd_status() {
    local id name
    printf 'bridge %s: %s\n' "${LAB_BRIDGE}" "$(link_exists "${LAB_BRIDGE}" && echo up || echo absent)"
    printf '%-15s %-15s %-7s %-7s %-6s %s\n' NODE IP UID USER NETNS VETH
    for id in $(existing_ids); do
        name=$(node_name "${id}")
        printf '%-15s %-15s %-7s %-7s %-6s %s\n' "${name}" "$(node_ip "${id}")" "$(node_uid "${id}")" \
            "$(is_lab_user "${name}" && echo ok || echo -)" \
            "$(netns_exists "${name}" && echo ok || echo -)" \
            "$(ip -br link show dev "$(veth_host "${id}")" 2>/dev/null | awk '{print $1" "$2}' || echo -)"
    done
}

# Run as the node's user inside its namespace, with hardening:
#   --no-new-privs          setuid binaries cannot raise privileges
#   --bounding-set=-all     no capabilities can ever be regained
#   --reset-env             clean environment (HOME, PATH from passwd)
node_exec() {
    local id=$1; shift
    local name uid
    name=$(node_name "${id}"); uid=$(node_uid "${id}")
    netns_exists "${name}" || die "node ${name} does not exist"
    is_lab_user "${name}" || die "user ${name} missing"
    exec ip netns exec "${name}" \
        setpriv --reuid="${uid}" --regid="${uid}" --clear-groups \
                --no-new-privs --inh-caps=-all --bounding-set=-all --reset-env \
                -- "$@"
}

cmd_exec() {
    [[ $# -ge 3 && $2 == "--" ]] || die "usage: exec ID -- CMD [ARGS...]"
    validate_id "$1"
    require_root exec
    local id=$1; shift 2
    node_exec "${id}" "$@"
}

cmd_shell() {
    [[ $# -eq 1 ]] || die "usage: shell ID"
    validate_id "$1"
    require_root shell
    node_exec "$1" /bin/bash --norc -i
}

main() {
    validate_config
    local cmd=${1:-help}
    shift || true
    case ${cmd} in
        up)     cmd_up "$@" ;;
        add)    cmd_add "$@" ;;
        del)    cmd_del "$@" ;;
        down)   cmd_down "$@" ;;
        status) cmd_status "$@" ;;
        exec)   cmd_exec "$@" ;;
        shell)  cmd_shell "$@" ;;
        help|-h|--help) usage ;;
        *) usage; exit 2 ;;
    esac
}

main "$@"
